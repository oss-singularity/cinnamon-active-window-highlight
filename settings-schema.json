{
  "show-top-bar": {
    "type": "checkbox",
    "default": true,
    "description": "Show top highlight bar"
  },
  "line-height": {
    "type": "spinbutton",
    "default": 4,
    "min": 1,
    "max": 25,
    "step": 1,
    "units": "px",
    "description": "Top bar height"
  },
  "width-percent": {
    "type": "spinbutton",
    "default": 80,
    "min": 10,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Top bar width relative to window"
  },
  "slant-percent": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 40,
    "step": 1,
    "units": "px",
    "description": "Top bar end slant"
  },
  "alpha-percent": {
    "type": "spinbutton",
    "default": 80,
    "min": 0,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Top bar opacity"
  },
  "anim-speed": {
    "type": "scale",
    "default": 5,
    "min": 1,
    "max": 20,
    "step": 1,
    "description": "Gradient animation speed"
  },
  "color-start": {
    "type": "colorchooser",
    "default": "rgb(0, 210, 255)",
    "description": "Top bar start color"
  },
  "color-end": {
    "type": "colorchooser",
    "default": "rgb(58, 123, 213)",
    "description": "Top bar end color"
  },
  "show-frame": {
    "type": "checkbox",
    "default": true,
    "description": "Show frame around active window"
  },
  "frame-width": {
    "type": "spinbutton",
    "default": 1,
    "min": 1,
    "max": 16,
    "step": 1,
    "units": "px",
    "description": "Frame width"
  },
  "frame-radius": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 64,
    "step": 1,
    "units": "px",
    "description": "Top corner radius"
  },
  "frame-alpha-percent": {
    "type": "spinbutton",
    "default": 95,
    "min": 5,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Frame opacity"
  },
  "frame-color": {
    "type": "colorchooser",
    "default": "rgb(0, 190, 255)",
    "description": "Frame color"
  }
}
