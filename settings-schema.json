{
  "show-top-bar": {
    "type": "checkbox",
    "default": true,
    "description": "Obere Markierungsleiste anzeigen"
  },
  "line-height": {
    "type": "spinbutton",
    "default": 4,
    "min": 1,
    "max": 25,
    "step": 1,
    "units": "px",
    "description": "Höhe der oberen Leiste"
  },
  "width-percent": {
    "type": "spinbutton",
    "default": 80,
    "min": 10,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Breite der oberen Leiste relativ zum Fenster"
  },
  "slant-percent": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 40,
    "step": 1,
    "units": "px",
    "description": "Schräge der Leistenenden"
  },
  "alpha-percent": {
    "type": "spinbutton",
    "default": 80,
    "min": 0,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Deckkraft der oberen Leiste"
  },
  "anim-speed": {
    "type": "scale",
    "default": 5,
    "min": 1,
    "max": 20,
    "step": 1,
    "description": "Geschwindigkeit der Farbverlaufsanimation"
  },
  "color-start": {
    "type": "colorchooser",
    "default": "rgb(0, 210, 255)",
    "description": "Startfarbe der oberen Leiste"
  },
  "color-end": {
    "type": "colorchooser",
    "default": "rgb(58, 123, 213)",
    "description": "Endfarbe der oberen Leiste"
  },
  "show-frame": {
    "type": "checkbox",
    "default": true,
    "description": "Rahmen um das aktive Fenster anzeigen"
  },
  "frame-width": {
    "type": "spinbutton",
    "default": 1,
    "min": 1,
    "max": 16,
    "step": 1,
    "units": "px",
    "description": "Rahmenbreite"
  },
  "frame-radius": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 64,
    "step": 1,
    "units": "px",
    "description": "Radius der oberen Rahmenecken"
  },
  "frame-alpha-percent": {
    "type": "spinbutton",
    "default": 95,
    "min": 5,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Deckkraft des Rahmens"
  },
  "frame-color": {
    "type": "colorchooser",
    "default": "rgb(0, 190, 255)",
    "description": "Rahmenfarbe"
  }
}
